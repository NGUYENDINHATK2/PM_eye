NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use EITHER of the two below (Supabase has both old & new names).
# Find it in Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# or, if your Supabase project shows "publishable key":
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Service role (SERVER ONLY — không bao giờ expose ra client) ----
# Dùng để: bootstrap đọc lương (admin), tạo user, set app_metadata.role
# Supabase → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Admin RBAC (server-side) ----
# CSV email được coi là admin ở tầng Next.js (fallback nếu JWT chưa có role).
# Vẫn phải set { "role": "admin" } trong Supabase App Metadata để pass RLS.
# ADMIN_EMAILS=ban@cong-ty.com

# ---- HTTP Basic Auth gate (optional) ----
# SITE_BASIC_AUTH=team:supersecretpassword
